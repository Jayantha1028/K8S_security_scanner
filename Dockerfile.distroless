# Ultra-Hardened Google Distroless Containerfile
# Base: gcr.io/distroless/python3-debian12:nonroot
# Benefits: Zero shell (/bin/sh doesn't exist), zero package manager, zero CVE surface, glibc-based.

FROM python:3.12-slim-bookworm AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --target=/build/pkgs -r requirements.txt

WORKDIR /app
COPY . /app

# Final Minimal Distroless Image
FROM gcr.io/distroless/python3-debian12:nonroot

LABEL org.opencontainers.image.title="k8s-native-scanner-distroless" \
      org.opencontainers.image.description="Google Distroless Enterprise Kubernetes Security Engine" \
      org.opencontainers.image.version="2.0.0"

WORKDIR /app

# Copy application and libraries
COPY --from=builder /build/pkgs /app/pkgs
COPY --from=builder /app /app

ENV PYTHONPATH="/app:/app/pkgs" \
    PYTHONUNBUFFERED=1

# Non-root user 65532 built into distroless
USER 65532:65532

ENTRYPOINT ["/usr/bin/python3", "/app/cli.py"]
CMD ["agent", "--watch", "--interval", "60"]
